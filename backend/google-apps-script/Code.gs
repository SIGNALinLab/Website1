const ALLOWED={application:'Applications',contact:'Contact'};function safeCell(v){const s=String(v==null?'':v).trim();return /^[=+\-@]/.test(s)?"'"+s:s;}function doPost(e){try{const p=JSON.parse(e.postData.contents||'{}'),name=ALLOWED[p.formType];if(!name)throw new Error('Unsupported form type');return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON);}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err)})).setMimeType(ContentService.MimeType.JSON);}}