const FORM_SCHEMAS={application:{sheet:'Applications',headers:['Timestamp','Name','Email','Program / Discipline','Participation Type','Research Interests','Technical Skills','Consent'],fields:['name','email','program','participationType','interests','skills','consent'],required:['name','email','program','participationType','interests','skills','consent']},contact:{sheet:'Contact',headers:['Timestamp','Name','Email','Subject','Message','Consent'],fields:['name','email','subject','message','consent'],required:['name','email','subject','message','consent']}};function safeCell(v){const t=String(v==null?'':v).trim();return /^[=+\-@]/.test(t)?"'"+t:t}function cleanPayload(raw,s){const o={};s.fields.forEach(f=>o[f]=safeCell(String(raw[f]??'').slice(0,10000)));s.required.forEach(f=>{if(!o[f])throw Error('Missing required field: '+f)});if(o.consent.toLowerCase()!=='yes')throw Error('Consent is required');if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(o.email))throw Error('Invalid email address');return o}function getOrCreateSheet_(ss,s){let sh=ss.getSheetByName(s.sheet);if(!sh)sh=ss.insertSheet(s.sheet);const r=sh.getRange(1,1,1,s.headers.length),cur=r.getValues()[0];if(s.headers.some((v,i)=>cur[i]!==v))r.setValues([s.headers]);sh.setFrozenRows(1);return sh}function getSpreadsheet_(){const p=PropertiesService.getScriptProperties(),id=p.getProperty('SIGNAL_SPREADSHEET_ID');if(id)return SpreadsheetApp.openById(id);const a=SpreadsheetApp.getActiveSpreadsheet();if(!a)throw Error('Spreadsheet is not configured.');p.setProperty('SIGNAL_SPREADSHEET_ID',a.getId());return a}function initializeSignalSheets(){const a=SpreadsheetApp.getActiveSpreadsheet();if(!a)throw Error('Open from the target Sheet.');PropertiesService.getScriptProperties().setProperty('SIGNAL_SPREADSHEET_ID',a.getId());Object.values(FORM_SCHEMAS).forEach(s=>getOrCreateSheet_(a,s))}function doPost(e){try{const p=JSON.parse(e.postData.contents),s=FORM_SCHEMAS[p.formType];if(!s)throw Error('Unsupported form type');const c=cleanPayload(p,s),ss=getSpreadsheet_(),lock=LockService.getScriptLock();lock.waitLock(10000);try{getOrCreateSheet_(ss,s).appendRow([new Date()].concat(s.fields.map(f=>c[f])))}finally{lock.releaseLock()}return ContentService.createTextOutput(JSON.stringify({ok:true})).setMimeType(ContentService.MimeType.JSON)}catch(err){return ContentService.createTextOutput(JSON.stringify({ok:false,error:String(err.message||err)})).setMimeType(ContentService.MimeType.JSON)}}